<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0b0719">
<title>Balaji Habib | AI & ML Developer</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
  --bg: #0b0719;
  --panel: #17112c;
  --text: #f8f5ff;
  --muted: #b9b0d4;
  --purple: #a66bff;
  --blue: #4b6bff;
  --cyan: #00e5ff;
  --pink: #ff3eb5;
  --orange: #ff8b5e;
  --border: rgba(220, 200, 255, .18);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 85px; }

body {
  margin: 0;
  background:
    radial-gradient(ellipse at 10% 10%, #a66bff26, transparent 35%),
    radial-gradient(ellipse at 90% 20%, #00e5ff16, transparent 32%),
    radial-gradient(ellipse at 80% 80%, #ff3eb516, transparent 30%),
    var(--bg);
  color: var(--text);
  font-family: "Outfit", sans-serif;
  overflow-x: hidden;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -1;
  background-image:
    linear-gradient(#ffffff08 1px, transparent 1px),
    linear-gradient(90deg, #ffffff08 1px, transparent 1px);
  background-size: 38px 38px;
}

a { color: inherit; text-decoration: none; }
.container { width: min(1160px, 90%); margin: auto; }

.gradient-text {
  color: transparent;
  background: linear-gradient(
    100deg,
    var(--purple),
    var(--blue),
    var(--cyan),
    var(--pink),
    var(--orange)
  );
  background-size: 300% 300%;
  background-clip: text;
  -webkit-background-clip: text;
  animation: gradientFlow 8s ease infinite;
}

@keyframes gradientFlow {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

/* NAVIGATION */
header {
  position: fixed;
  inset: 0 0 auto;
  z-index: 100;
  background: #0b0719d9;
  backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--border);
}

nav {
  min-height: 75px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.brand {
  font: 800 1.35rem "Space Grotesk";
  letter-spacing: -1px;
}

.brand span {
  color: var(--cyan);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 24px;
  color: var(--muted);
  font-size: .9rem;
  font-weight: 600;
}

.nav-links a:hover { color: var(--cyan); }

.menu-button {
  display: none;
  color: white;
  background: var(--panel);
  border: 1px solid var(--border);
  padding: 10px 13px;
  border-radius: 12px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid #ffffff20;
  border-radius: 999px;
  padding: 13px 20px;
  color: white;
  font-weight: 700;
  background: linear-gradient(
    110deg,
    #7538f4,
    #4b6bff,
    #00bcd4,
    #e72a9b
  );
  background-size: 250% 250%;
  box-shadow: 0 8px 30px #7538f444;
  transition: .25s;
  cursor: pointer;
}

.button:hover {
  transform: translateY(-3px);
  background-position: 100% 50%;
}

.button.secondary {
  background: #ffffff08;
  box-shadow: none;
}

/* HERO */
section { padding: 100px 0; }

.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding-top: 120px;
  position: relative;
  isolation: isolate;
}

#particle-scene {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  pointer-events: none;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 35px;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  border: 1px solid #a66bff55;
  background: #1b1230c9;
  color: #d8c0ff;
  border-radius: 999px;
  padding: 9px 14px;
  font-size: .82rem;
  font-weight: 700;
}

.live-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #42ffba;
  box-shadow: 0 0 12px #42ffba;
}

h1 {
  font: 700 clamp(3rem, 6vw, 5.2rem)/1 "Space Grotesk";
  letter-spacing: -3px;
  margin: 24px 0;
}

.hero-description {
  max-width: 570px;
  color: var(--muted);
  font-size: 1.08rem;
  line-height: 1.8;
}

.hero-actions, .quick-facts {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 25px;
}

.fact {
  padding: 10px 13px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: #ffffff08;
  color: var(--muted);
  font-size: .82rem;
}

.fact strong { color: white; }

/* SWINGING ID CARD */
.id-stage {
  min-height: 650px;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  perspective: 1400px;
  position: relative;
}

.id-stage::before {
  content: "";
  position: absolute;
  width: 340px;
  height: 340px;
  border-radius: 50%;
  background: conic-gradient(
    var(--purple), var(--blue), var(--cyan),
    var(--pink), var(--orange), var(--purple)
  );
  filter: blur(60px);
  opacity: .22;
  animation: halo 7s ease-in-out infinite alternate;
  z-index: -1;
}

@keyframes halo {
  to { transform: scale(1.18) rotate(25deg); opacity: .42; }
}

.lanyard-rig {
  width: min(355px, 88vw);
  transform-origin: top center;
  transform-style: preserve-3d;
  animation: swing 5s ease-in-out infinite;
  will-change: transform;
}

@keyframes swing {
  0%, 100% { transform: rotateZ(-3.5deg); }
  50% { transform: rotateZ(3.5deg); }
}

.lanyard {
  width: 70px;
  height: 125px;
  margin: 0 auto -4px;
  position: relative;
  background: linear-gradient(
    90deg, var(--purple), var(--pink),
    var(--cyan), var(--blue)
  );
  box-shadow: 0 0 25px #a66bff55;
  clip-path: polygon(12% 0, 88% 0, 100% 100%, 0 100%);
}

.lanyard::after {
  content: "BH • AI";
  position: absolute;
  top: 35px;
  left: 50%;
  transform: translateX(-50%) rotate(90deg);
  color: white;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2px;
  white-space: nowrap;
}

.lanyard-stitch {
  position: absolute;
  inset: 8px 10px;
  border: 1px dashed #ffffffb0;
  border-top: 0;
}

.lanyard-hook {
  width: 28px;
  height: 40px;
  margin: 0 auto;
  position: relative;
  z-index: 3;
  border: 6px solid #c9cce8;
  border-radius: 7px 7px 12px 12px;
  background: linear-gradient(90deg, #7b80a8, white, #a6a9d0);
}

.id-card {
  width: 100%;
  padding: 4px;
  border-radius: 25px;
  position: relative;
  overflow: hidden;
  background: linear-gradient(
    135deg, var(--cyan), var(--blue),
    var(--purple), var(--pink), var(--orange)
  );
  background-size: 250% 250%;
  animation: gradientFlow 8s ease infinite;
  box-shadow: 0 25px 65px #0009, 0 0 28px #9a5cff44;
  transform-style: preserve-3d;
  transition: box-shadow .3s;
}

.id-inner {
  border-radius: 21px;
  overflow: hidden;
  background: linear-gradient(155deg, #1b1534, #100c21);
}

.id-header {
  padding: 18px;
  background: linear-gradient(115deg, #291748, #162b4b, #321635);
  border-bottom: 1px solid #ffffff18;
}

.university-mark {
  display: flex;
  align-items: center;
  gap: 11px;
}

.university-symbol {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 14px;
  font: 800 19px "Space Grotesk";
  background: linear-gradient(135deg, var(--purple), var(--blue), var(--cyan));
  box-shadow: 0 5px 20px #7738ff55;
}

.university-name {
  font-size: .83rem;
  font-weight: 800;
  line-height: 1.3;
}

.university-subtitle {
  color: #b9b0d8;
  font-size: .65rem;
  letter-spacing: .7px;
  margin-top: 4px;
}

.id-main { padding: 19px; }

.id-profile {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 18px;
}

.photo-frame {
  flex: 0 0 100px;
  width: 100px;
  height: 115px;
  padding: 3px;
  border-radius: 17px;
  background: linear-gradient(
    135deg, var(--cyan), var(--blue),
    var(--purple), var(--pink)
  );
}

.photo-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 25%;
  border-radius: 14px;
  display: block;
  background: #21193b;
}

.id-label {
  color: #bda0ff;
  text-transform: uppercase;
  font-size: .62rem;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.id-name {
  font: 800 1.05rem/1.15 "Space Grotesk";
  overflow-wrap: anywhere;
  margin: 8px 0;
}

.id-course {
  color: #c5bddf;
  font-size: .77rem;
  line-height: 1.4;
  font-weight: 600;
}

.id-details {
  display: grid;
  grid-template-columns: .55fr 1.45fr;
  gap: 9px;
}

.id-detail, .id-contact {
  padding: 10px;
  background: #ffffff08;
  border: 1px solid #ffffff12;
  border-radius: 11px;
  min-width: 0;
}

.id-detail span, .id-contact span {
  display: block;
  color: #b6a9d7;
  font-size: .6rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .6px;
  margin-bottom: 5px;
}

.id-detail strong {
  font-size: .74rem;
  overflow-wrap: anywhere;
}

.id-contact {
  margin-top: 9px;
  background: linear-gradient(100deg, #7538f42b, #00d9ed1b, #ff3eb51c);
}

.id-contact strong {
  font-size: .76rem;
  overflow-wrap: anywhere;
}

.id-contact a:hover { color: var(--cyan); }

.id-footer {
  padding: 13px 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  background: linear-gradient(100deg, #5f31cb, #386bff, #008eaa, #bd2788);
}

.id-footer strong { font-size: .65rem; letter-spacing: 1px; }
.id-footer small { font-size: .6rem; }

.id-chip {
  width: 28px;
  height: 21px;
  border: 1px solid #ffffffb5;
  border-radius: 5px;
  background: repeating-linear-gradient(90deg, transparent 0 6px, #ffffff55 6px 7px);
}

.id-caption {
  margin-top: 20px;
  color: #aaa0ca;
  font-size: .8rem;
  text-align: center;
}

/* SECTIONS */
.section-label {
  color: #c1a2ff;
  font-size: .8rem;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.section-heading { max-width: 720px; margin-bottom: 38px; }

.section-heading h2, .contact-panel h2 {
  font: 700 clamp(2.1rem, 4vw, 3.5rem)/1.08 "Space Grotesk";
  letter-spacing: -2px;
  margin: 14px 0;
}

.section-heading p, .glass-card p, .project-card p, .contact-panel p {
  color: var(--muted);
  line-height: 1.8;
}

.about-grid, .skills-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.glass-card {
  padding: 27px;
  border: 1px solid var(--border);
  border-radius: 23px;
  background: linear-gradient(145deg, #ffffff0c, #ffffff04);
  box-shadow: 0 20px 60px #0003;
  backdrop-filter: blur(12px);
}

.glass-card h3 { margin-top: 0; }

.skills-list, .project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 18px;
}

.skill, .project-tags span {
  padding: 9px 12px;
  border-radius: 10px;
  background: linear-gradient(110deg, #a66bff24, #4b6bff20, #00e5ff18, #ff3eb51c);
  color: #e4d8ff;
  font-size: .82rem;
  font-weight: 700;
  border: 1px solid #ffffff17;
}

/* PROJECTS */
.projects-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.project-card {
  min-height: 300px;
  padding: 25px;
  border-radius: 24px;
  border: 1px solid var(--border);
  background: linear-gradient(145deg, #1c1536, #100d21);
  box-shadow: 0 15px 40px #0003;
  position: relative;
  overflow: hidden;
  transform-style: preserve-3d;
  transition: border-color .25s, box-shadow .25s;
}

.project-card::before {
  content: "";
  position: absolute;
  width: 160px;
  height: 160px;
  border-radius: 50%;
  background: var(--orb, #a66bff30);
  filter: blur(38px);
  top: -65px;
  right: -50px;
}

.project-card:hover {
  border-color: #a66bff88;
  box-shadow: 0 24px 50px #0005;
}

.project-icon {
  width: 55px;
  height: 55px;
  padding: 3px;
  border-radius: 16px;
  display: grid;
  place-items: center;
  margin-bottom: 22px;
  font-size: 1.5rem;
  background: linear-gradient(135deg, var(--purple), var(--blue), var(--cyan), var(--pink));
  transform: translateZ(20px);
}

.project-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  border-radius: 13px;
  background: white;
}

.project-card h3, .project-card p, .project-tags {
  position: relative;
  transform: translateZ(15px);
}

.project-card p { font-size: .92rem; }

.project-tags span {
  padding: 6px 9px;
  font-size: .7rem;
}

/* CONTACT */
.contact-panel {
  padding: clamp(28px, 5vw, 55px);
  border-radius: 30px;
  background: linear-gradient(120deg, #6e39ce40, #3157bb38, #00a7b52b, #c12b8538, #a85b3233);
  border: 1px solid #ffffff20;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 25px;
}

.contact-panel p { max-width: 480px; margin-bottom: 0; }

footer {
  padding: 27px 0;
  border-top: 1px solid var(--border);
  color: var(--muted);
  text-align: center;
  font-size: .85rem;
}

.reveal {
  opacity: 0;
  transform: translateY(22px);
  transition: opacity .7s ease, transform .7s ease;
}

.reveal.visible { opacity: 1; transform: translateY(0); }

/* RESPONSIVE */
@media (max-width: 900px) {
  .hero-grid { grid-template-columns: 1fr; }
  .hero-copy { text-align: center; }
  .hero-description { margin-left: auto; margin-right: auto; }
  .hero-actions, .quick-facts { justify-content: center; }
  .id-stage { min-height: 620px; }
  .projects-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 650px) {
  section { padding: 75px 0; }
  .nav-links {
    display: none;
    position: absolute;
    top: 68px;
    left: 5%;
    right: 5%;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: #15102bf5;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  .nav-links.open { display: flex; }
  .menu-button { display: block; }
  .hero { padding-top: 110px; }
  h1 { letter-spacing: -2px; }
  .id-stage { min-height: 570px; }
  .lanyard-rig { width: min(355px, 88vw); }
  .projects-grid, .about-grid, .skills-grid { grid-template-columns: 1fr; }
  .contact-panel { align-items: flex-start; flex-direction: column; }
  .id-profile { gap: 10px; }
  .photo-frame { flex-basis: 85px; width: 85px; height: 105px; }
  .id-name { font-size: 1rem; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
  }
}
</style>
</head>

